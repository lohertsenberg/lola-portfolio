@import url('https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Playfair+Display:ital,wght@0,500;0,600;0,700;1,600&display=swap');

:root {
  --navy: #13294B;
  --pink: #F29BB2;
  --light-pink: #FCE5EB;
  --blue: #A9C9E8;
  --light-blue: #E8F2FA;
  --cream: #FFFDF8;
  --text: #253246;
  --gray: #667085;
}

body {
  background-color: var(--cream);
  color: var(--text);
  font-family: "DM Sans", sans-serif;
}

h1, h2, h3 {
  font-family: "Playfair Display", serif;
  color: var(--navy);
}

/* NAVIGATION */

.navbar {
  background-color: var(--cream) !important;
  border-bottom: 1px solid #e8e5df;
  padding-top: 18px;
  padding-bottom: 18px;
}

.navbar-brand {
  font-family: "Playfair Display", serif;
  font-style: italic;
  font-size: 25px;
  color: var(--navy) !important;
}

.navbar-nav .nav-link {
  color: var(--navy) !important;
  font-size: 12px;
  font-weight: 600;
  text-transform: uppercase;
  letter-spacing: 1px;
  margin: 0 10px;
}

/* MAIN PAGE */

.page-layout-custom {
  max-width: 1200px;
  margin: auto;
}

/* HERO */

.hero {
  padding: 80px 0 100px 0;
}

.hero-title {
  font-family: "Playfair Display", serif;
  color: var(--navy);
  font-size: 78px;
  font-weight: 600;
  line-height: 0.98;
  margin-bottom: 25px;
}

.pink {
  color: var(--pink);
  font-style: italic;
}

.hero-description {
  font-size: 17px;
  line-height: 1.7;
  max-width: 560px;
  margin-top: 25px;
  color: var(--text);
}

.hero-image {
  width: 430px;
  height: 430px;
  max-width: 100%;
  object-fit: cover;
  object-position: center top;
  border-radius: 50%;
  display: block;
  margin: 0 auto;
}

/* BUTTON */

.portfolio-button {
  display: inline-block;
  margin-top: 20px;
  padding: 14px 25px;
  background-color: var(--light-pink);
  color: var(--navy);
  text-decoration: none;
  font-size: 12px;
  font-weight: 700;
  letter-spacing: 1.5px;
  transition: 0.2s;
}

.portfolio-button:hover {
  background-color: var(--pink);
  color: var(--navy);
}

/* SECTIONS */

.portfolio-section {
  padding: 80px 0;
}

.section-label {
  color: var(--navy);
  font-size: 11px;
  font-weight: 700;
  letter-spacing: 2px;
  text-transform: uppercase;
}

.section-title {
  font-family: "Playfair Display", serif;
  color: var(--navy);
  font-size: 50px;
  margin-top: 5px;
  margin-bottom: 35px;
}

/* PROJECT CARDS */

.project-card {
  background-color: white;
  border: 1px solid #e8e5df;
  height: 100%;
  transition: transform 0.2s;
}

.project-card:hover {
  transform: translateY(-5px);
}

.project-image {
  width: 100%;
  height: 220px;
  object-fit: cover;
}

.project-content {
  padding: 22px;
}

.project-category {
  color: var(--pink);
  font-size: 10px;
  font-weight: 700;
  letter-spacing: 1.5px;
  text-transform: uppercase;
}

.project-title {
  font-family: "Playfair Display", serif;
  color: var(--navy);
  font-size: 25px;
  margin-top: 5px;
}

.project-description {
  color: var(--gray);
  font-size: 14px;
  line-height: 1.6;
}

/* MOBILE */

@media (max-width: 768px) {

  .hero-title {
    font-size: 50px;
  }

  .hero {
    padding: 50px 0;
  }

 .hero-image {
  width: 320px;
  height: 320px;
  margin: 40px auto 0 auto;
}

  .section-title {
    font-size: 40px;
  }
}
.project-skills {
  margin-top: 18px;
  color: var(--navy);
  font-size: 10px;
  font-weight: 700;
  letter-spacing: 1.2px;
  line-height: 1.6;
}/* INDIVIDUAL PROJECT PAGES */

.project-hero {
  padding: 80px 0 70px 0;
  max-width: 900px;
}

.project-page-title {
  font-family: "Playfair Display", serif;
  color: var(--navy);
  font-size: 72px;
  line-height: 1;
  margin-top: 15px;
  margin-bottom: 30px;
}

.project-page-intro {
  color: var(--text);
  font-size: 19px;
  line-height: 1.7;
  max-width: 750px;
}

.case-study-section {
  padding: 70px 0;
}

.case-study-title {
  font-family: "Playfair Display", serif;
  color: var(--navy);
  font-size: 45px;
  margin-top: 10px;
  margin-bottom: 25px;
}

.case-study-section p {
  max-width: 800px;
  font-size: 17px;
  line-height: 1.8;
}

/* PDF VIEWER */

.pdf-viewer {
  width: 100%;
  height: 850px;
  border: 1px solid #e8e5df;
  margin-top: 30px;
  background-color: white;
}

/* PROJECT PAGE MOBILE */

@media (max-width: 768px) {

  .project-page-title {
    font-size: 50px;
  }

  .case-study-title {
    font-size: 36px;
  }

  .pdf-viewer {
    height: 600px;
  }

}.project-link {
  display: inline-block;
  margin-top: 22px;
  color: var(--navy);
  font-size: 11px;
  font-weight: 700;
  letter-spacing: 1.5px;
  text-decoration: none;
  border-bottom: 2px solid var(--pink);
  padding-bottom: 4px;
  transition: 0.2s ease;
}

.project-link:hover {
  color: var(--pink);
}.project-video {
  width: 100%;
  max-width: 1000px;
  display: block;
  margin-top: 30px;
  background-color: #000;
}/* SOCIAL MEDIA GALLERY */

.social-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 30px;
  margin-top: 30px;
}

.social-item {
  background-color: white;
  border: 1px solid #e8e5df;
  padding: 15px;
}

.social-image {
  display: block;
  width: 100%;
  height: auto;
}

.social-video {
  max-width: 700px;
}

@media (max-width: 768px) {

  .social-grid {
    grid-template-columns: 1fr;
  }

}/* INFOGRAPHIC PROJECT */

.infographic-viewer {
  width: 100%;
  height: 1100px;
  border: 1px solid #e8e5df;
  background-color: white;
  margin-top: 30px;
  margin-bottom: 20px;
}

@media (max-width: 768px) {

  .infographic-viewer {
    height: 750px;
  }

}/* ABOUT PAGE */

.about-layout {
  display: grid;
  grid-template-columns: 0.8fr 1.2fr;
  gap: 70px;
  align-items: start;
  padding: 20px 0 90px 0;
}

.about-photo img {
  width: 100%;
  max-height: 650px;
  object-fit: cover;
}

.about-text h2 {
  font-size: 42px;
  margin-top: 0;
  margin-bottom: 25px;
}

.about-text p {
  font-size: 17px;
  line-height: 1.8;
  color: var(--text);
}

.interest-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 20px;
}

.interest-card {
  background-color: var(--light-blue);
  padding: 30px 25px;
  min-height: 200px;
}

.interest-card h3 {
  font-size: 25px;
  margin-top: 0;
}

.interest-card p {
  font-size: 14px;
  line-height: 1.7;
}

@media (max-width: 768px) {

  .about-layout {
    grid-template-columns: 1fr;
    gap: 40px;
  }

  .interest-grid {
    grid-template-columns: 1fr;
  }

}/* EXPERIENCE PAGE */

.experience-list {
  padding: 20px 0 90px 0;
}

.experience-item {
  display: grid;
  grid-template-columns: 180px 1fr;
  gap: 50px;
  padding: 50px 0;
  border-top: 1px solid #ddd9d2;
}

.experience-item:last-child {
  border-bottom: 1px solid #ddd9d2;
}

.experience-date {
  color: var(--gray);
  font-size: 13px;
  margin-bottom: 10px;
}

.experience-type {
  color: var(--pink);
  font-size: 11px;
  font-weight: 700;
  letter-spacing: 1.5px;
}

.experience-main h2 {
  font-family: "Playfair Display", serif;
  color: var(--navy);
  font-size: 38px;
  margin: 0 0 5px 0;
}

.experience-main h3 {
  font-family: "DM Sans", sans-serif;
  color: var(--text);
  font-size: 17px;
  font-weight: 600;
  margin: 0 0 20px 0;
}

.experience-main p {
  max-width: 700px;
  font-size: 16px;
  line-height: 1.8;
  color: var(--gray);
}

@media (max-width: 768px) {

  .experience-item {
    grid-template-columns: 1fr;
    gap: 20px;
  }

}/* CONTACT PAGE */

.contact-page {
  padding: 110px 0 140px 0;
  max-width: 950px;
}

.contact-title {
  font-family: "Playfair Display", serif;
  color: var(--navy);
  font-size: 75px;
  line-height: 1;
  max-width: 850px;
  margin-top: 15px;
  margin-bottom: 35px;
}

.contact-intro {
  max-width: 700px;
  font-size: 18px;
  line-height: 1.8;
  color: var(--gray);
}

.contact-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 30px;
  margin-top: 70px;
}

.contact-item {
  background-color: var(--light-blue);
  padding: 35px;
}

.contact-label {
  color: var(--pink);
  font-size: 11px;
  font-weight: 700;
  letter-spacing: 1.5px;
  margin-bottom: 15px;
}

.contact-item a {
  color: var(--navy);
  font-size: 17px;
  font-weight: 600;
  text-decoration: none;
}

.contact-item a:hover {
  color: var(--pink);
}

@media (max-width: 768px) {

  .contact-title {
    font-size: 50px;
  }

  .contact-grid {
    grid-template-columns: 1fr;
  }

}/* FINAL NAVBAR */

.navbar {
  background: #FFFDF8 !important;
  border-bottom: 1px solid #E8E5DF !important;
  min-height: 72px;
}

.navbar-brand {
  color: #13294B !important;
  font-family: "Playfair Display", serif !important;
  font-size: 25px !important;
  font-weight: 600 !important;
}

.navbar-nav .nav-link {
  color: #13294B !important;
  font-family: "DM Sans", sans-serif !important;
  font-size: 12px !important;
  font-weight: 600 !important;
  letter-spacing: 1px;
  text-transform: uppercase;
}

.navbar-nav .nav-link:hover {
  color: #F29BB2 !important;
}

.navbar-nav .nav-link.active,
.navbar-nav .active > .nav-link {
  color: #F29BB2 !important;
}

.navbar-toggler {
  border-color: #13294B !important;
}

@media (max-width: 991px) {
  .navbar-nav .nav-link {
    padding: 8px 0 !important;
  }
}/* HOME PAGE */

.home-hero {
  max-width: 1200px;
  margin: 0 auto;
  padding: 90px 0 110px 0;
  display: grid;
  grid-template-columns: 1.1fr 0.9fr;
  gap: 70px;
  align-items: center;
}

.home-hero-text {
  padding-left: 10px;
}

.home-title {
  font-family: "Playfair Display", serif;
  color: var(--navy);
  font-size: clamp(58px, 6vw, 88px);
  line-height: 0.95;
  margin: 18px 0 25px 0;
}

.home-intro {
  max-width: 600px;
  font-size: 18px;
  line-height: 1.75;
  color: var(--gray);
}

.home-hero-photo {
  display: flex;
  justify-content: center;
  align-items: center;
}

.home-headshot {
  width: 430px;
  height: 430px;
  max-width: 100%;
  object-fit: cover;
  object-position: center top;
  border-radius: 50%;
  display: block;
  box-shadow: 0 0 0 18px var(--light-pink);
}

/* FEATURED PROJECTS */

.home-featured {
  max-width: 1200px;
  margin: 0 auto;
  padding: 30px 0 110px 0;
}

.featured-header {
  display: flex;
  align-items: end;
  justify-content: space-between;
  margin-bottom: 35px;
}

.view-all {
  color: var(--pink);
  font-size: 11px;
  font-weight: 700;
  letter-spacing: 1.5px;
  text-decoration: none;
  padding-bottom: 6px;
}

.view-all:hover {
  color: var(--navy);
}

.featured-grid {
  row-gap: 25px;
}

.featured-card {
  background: white;
  border: 1px solid #e8e5df;
  height: 100%;
  transition: transform 0.2s ease;
}

.featured-card:hover {
  transform: translateY(-5px);
}

.featured-image {
  width: 100%;
  height: 190px;
  object-fit: cover;
  display: block;
}

.featured-card-content {
  padding: 20px;
}

.featured-card-content h3 {
  font-family: "Playfair Display", serif;
  color: var(--navy);
  font-size: 24px;
  line-height: 1.15;
  margin: 7px 0 10px 0;
}

.featured-card-content p {
  color: var(--gray);
  font-size: 13px;
  line-height: 1.65;
  margin-bottom: 15px;
}

.featured-card .project-link {
  margin-top: 5px;
}

/* HOME CALLOUT */

.home-callout {
  background: var(--light-blue);
  padding: 85px 20px;
}

.callout-content {
  max-width: 850px;
  margin: 0 auto;
  text-align: center;
}

.callout-content h2 {
  font-family: "Playfair Display", serif;
  color: var(--navy);
  font-size: 48px;
  line-height: 1.1;
  margin: 15px 0 20px 0;
}

.callout-content p {
  max-width: 680px;
  margin: 0 auto 25px auto;
  color: var(--gray);
  font-size: 16px;
  line-height: 1.8;
}


/* RESPONSIVE */

@media (max-width: 900px) {

  .home-hero {
    grid-template-columns: 1fr;
    text-align: center;
    padding: 65px 25px 80px 25px;
  }

  .home-hero-text {
    padding-left: 0;
  }

  .home-intro {
    margin-left: auto;
    margin-right: auto;
  }

  .home-hero-photo {
    margin-top: 25px;
  }

  .featured-header {
    padding: 0 25px;
  }

  .home-featured {
    padding-left: 15px;
    padding-right: 15px;
  }

}

@media (max-width: 600px) {

  .home-title {
    font-size: 52px;
  }

  .home-headshot {
    width: 300px;
    height: 300px;
    box-shadow: 0 0 0 12px var(--light-pink);
  }

  .featured-header {
    align-items: start;
  }

  .callout-content h2 {
    font-size: 38px;
  }

}